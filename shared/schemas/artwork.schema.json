{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://art-rag.local/schemas/artwork.schema.json",
  "title": "Artwork",
  "description": "知識庫中一幅畫一個 JSON 檔（kb/artworks/<id>.json）。共用層 §二，負責：D。",
  "type": "object",
  "additionalProperties": false,
  "required": ["id", "title", "artist", "date_text", "collection", "image", "source_url", "descriptions"],
  "properties": {
    "id": {
      "type": "string",
      "description": "<來源代碼>-<編號>，只用小寫 ASCII；檔名、資料庫主鍵、前端路由都用它",
      "pattern": "^[a-z]+-[a-z0-9]+$"
    },
    "source_id": { "type": "string", "description": "來源機構的原始編號（可含中文）" },
    "title": {
      "type": "object",
      "additionalProperties": false,
      "required": ["zh"],
      "properties": { "zh": { "type": "string", "minLength": 1 }, "en": { "type": "string" } }
    },
    "artist": {
      "type": "object",
      "additionalProperties": false,
      "required": ["zh"],
      "properties": { "zh": { "type": "string", "minLength": 1 }, "en": { "type": "string" } }
    },
    "date_text": { "type": "string", "minLength": 1 },
    "medium": { "type": "string" },
    "dimensions": { "type": "string" },
    "collection": { "type": "string", "minLength": 1 },
    "image": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "license"],
      "properties": {
        "path": { "type": "string", "pattern": "^kb/images/[a-z]+-[a-z0-9]+\\.(jpg|png|webp)$" },
        "license": { "$ref": "#/$defs/license" },
        "attribution": { "type": "string", "description": "CC BY 4.0 必填的標示文字" },
        "source_url": { "type": "string", "format": "uri", "description": "圖檔實際下載頁" }
      }
    },
    "source_url": { "type": "string", "format": "uri" },
    "descriptions": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["lang", "text", "license"],
        "anyOf": [{ "required": ["source_url"] }, { "required": ["source"] }],
        "properties": {
          "lang": { "type": "string", "enum": ["zh", "en"] },
          "topic": { "type": "string", "description": "段落主題，例如：構圖、技法、創作背景" },
          "text": { "type": "string", "minLength": 20 },
          "source_url": { "type": "string", "format": "uri" },
          "source": { "type": "string", "minLength": 1, "description": "沒有網址的出處（使用者投稿、外部上傳的文件）；與 source_url 至少填一個" },
          "license": { "$ref": "#/$defs/license" },
          "attribution": { "type": "string" },
          "region": { "type": "string", "description": "這段講的是畫面上哪一塊（regions.items 的 id，docs/adr/029）" },
          "speaker": { "type": "string", "minLength": 1, "description": "第一人稱的解說是誰說的（藝術家的區域解說，docs/adr/029）；建索引時段落寫成「<speaker>說：「…」」，模型才不會把「我」當成畫家" }
        }
      }
    },
    "regions": {
      "type": "object",
      "additionalProperties": false,
      "required": ["image_size", "items"],
      "description": "畫面上圈出的區域（docs/adr/029）。座標是相對 image.path 那張圖的 0–1（x 往右、y 往下），和影像對位的位置框同一套",
      "properties": {
        "image_size": {
          "type": "array",
          "items": { "type": "integer", "minimum": 1 },
          "minItems": 2,
          "maxItems": 2,
          "description": "圈區域時那張圖的寬、高（像素）。換圖後尺寸對不上，建索引會要求重新圈"
        },
        "items": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/region" } }
      }
    },
    "style_tags": { "type": "array", "items": { "type": "string" } },
    "intake": {
      "type": "object",
      "additionalProperties": false,
      "required": ["method", "date", "confirmed_by"],
      "description": "照片建檔紀錄（docs/adr/013）：圖檔是拍的照片、資料由人填，誰確認收錄",
      "properties": {
        "method": { "type": "string", "enum": ["photo"] },
        "date": { "type": "string", "format": "date" },
        "draft_id": { "type": "string" },
        "generated_description": { "type": "boolean", "description": "介紹段落是系統依欄位寫的「基本資料」" },
        "confirmed_by": { "type": "string", "description": "按「收錄」的展示帳號" }
      }
    }
  },
  "$defs": {
    "license": {
      "type": "string",
      "enum": ["CC0", "公有領域", "CC BY 4.0"],
      "description": "授權白名單；其他或不明者不收"
    },
    "region": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "label", "points"],
      "properties": {
        "id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]*$", "description": "同一幅畫內不重複；段落的 region 指向它" },
        "label": { "type": "string", "minLength": 1, "maxLength": 30, "description": "這一塊叫什麼，例如：騾隊與後方樹叢" },
        "points": {
          "type": "array",
          "minItems": 3,
          "maxItems": 64,
          "description": "多邊形的頂點，依序連起來；矩形就是 4 個點",
          "items": {
            "type": "array",
            "minItems": 2,
            "maxItems": 2,
            "items": { "type": "number", "minimum": 0, "maximum": 1 }
          }
        }
      }
    }
  }
}
