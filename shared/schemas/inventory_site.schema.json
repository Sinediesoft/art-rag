{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://art-rag.local/schemas/inventory_site.schema.json",
  "title": "InventorySite",
  "description": "工廠庫存示範資料的共用設定（kb/inventory/site.json）：資料日期與倉庫清單。Text-to-SQL 把 as_of 當成「今天」。共用層 §二，負責：D。",
  "type": "object",
  "additionalProperties": false,
  "required": ["as_of", "company", "warehouses"],
  "properties": {
    "as_of": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$", "description": "庫存快照日期" },
    "company": { "type": "string", "minLength": 1 },
    "note": { "type": "string" },
    "warehouses": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["warehouse_id", "name", "kind", "site"],
        "properties": {
          "warehouse_id": { "type": "string", "pattern": "^WH-[A-Z0-9]+$" },
          "name": { "type": "string", "minLength": 1 },
          "kind": {
            "enum": ["成品", "待檢", "隔離"],
            "description": "成品倉只放「可用／保留」，待檢區只放「待檢」，隔離區只放「不良」"
          },
          "site": { "type": "string", "minLength": 1, "description": "廠區" }
        }
      }
    }
  }
}
