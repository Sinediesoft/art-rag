# 複製成 .env 後修改；.env 不進 Git。所有設定由 backend/app/core/config.py 讀取。

# real：呼叫真的模型；mock：embedding／生成都回固定結果（沒有 GPU、沒有模型的電腦也能跑）
LLM_MODE=real
EMBED_MODE=real

# --- C. 混合式（主架構）：本地 Ollama 的 OpenAI 相容介面 ---
# 組員開發時改成推論伺服器的 Tailscale 位址，例如 http://100.x.y.z:11434/v1（不要用公網 IP）
HYBRID_BASE_URL=http://localhost:11434/v1
# 留空＝shared/models.yaml 的預設（qwen3-vl:4b-instruct）；5070 Ti 主機改 qwen3-vl:8b-instruct
HYBRID_MODEL=
HYBRID_API_KEY=ollama

# --- 本地備援模型：主推論伺服器失敗時改走這裡（全程不改走雲端）---
# 留空＝與 HYBRID_BASE_URL 同一台；也可指向 Mac 備用機的 Tailscale 位址。只接受本機或內網位址
HYBRID_FALLBACK_BASE_URL=
# 留空＝shared/models.yaml 的預設（qwen3-vl:4b-instruct）；主力為 8B 時用 4B 當降級模型
HYBRID_FALLBACK_MODEL=
HYBRID_FALLBACK_API_KEY=ollama

# --- A. 雲端 API（只當對照組：A1 api_nokb 無檢索、A2 api_kb 有檢索）---
# 預設 false：正式服務不呼叫任何雲端 API；只在跑評估（make eval-cloud）與策略比較頁時改 true
ALLOW_CLOUD=false
# Gemini：https://generativelanguage.googleapis.com/v1beta/openai/
# OpenAI：https://api.openai.com/v1    Claude：https://api.anthropic.com/v1/
API_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
API_MODEL=
# 只供對照組評估使用；各人自己申請、不共用、不貼在群組；請在平台設定每月額度上限，並關閉「資料用於訓練」
API_KEY=

# --- 工廠機械加工圖：Ortho2CAD（三視圖 → CadQuery 程式碼）---
# make ortho2cad 啟動的 llama-server（router 模式，可依記憶體狀況卸載／自動重新載入）；只接受本機或內網位址
ORTHO2CAD_BASE_URL=http://localhost:8081/v1
# 留空＝shared/models.yaml 的預設（ortho2cad，即 llama-server --alias）
ORTHO2CAD_MODEL=
ORTHO2CAD_API_KEY=none

# --- 生產排程：Timefold Solver 排程服務（make scheduler-setup 建置、make scheduler 啟動）---
# 連不上時排程頁自動改用簡易排程（交期優先派工，不做最佳化）；mock＝一律用簡易排程
SCHEDULER_BASE_URL=http://localhost:8082
SCHEDULER_MODE=real

# --- 記憶體管理：系統記憶體使用率超過門檻時，釋放目前流程用不到的模型（下次用到自動重新載入）---
MEMORY_GUARD=true
MEMORY_HIGH_PCT=80
MEMORY_CHECK_INTERVAL_S=5

# --- B. 本地 LoRA（選做，插槽已保留）---
LORA_ENABLED=false
LORA_BASE_URL=http://localhost:11434/v1
LORA_MODEL=
LORA_API_KEY=ollama

# 模型下載完成（make index 跑過一次）後改 true：embedding 模型只讀本機快取，不連 Hugging Face（斷網可用）
HF_OFFLINE=false

# 檢索段落篩選（MIRA 的 Rearrange）：回答前先請本地模型挑出有幫助的段落，只用挑中的
# 留空＝shared/models.yaml 的預設（關）；true／false 覆寫這台主機。GTX 1650 每題約多 6 秒
REARRANGE=

# --- 資料庫：PostgreSQL 17 + pgvector，跑在 Docker（deploy/docker-compose.yml；make db-up）---
# 畫作、段落、向量、manifest 與使用紀錄都存這裡；改完執行 make index（或 make index-db）寫入
# 沒有 Docker 的電腦留空＝檔案索引（data/index/）＋SQLite。用 127.0.0.1：資料庫只綁本機的 IPv4 位址
DATABASE_URL=postgresql://artrag:artrag@127.0.0.1:5432/artrag
# docker compose 建資料庫時用；改了要一起改上面的 DATABASE_URL
POSTGRES_DB=artrag
POSTGRES_USER=artrag
POSTGRES_PASSWORD=artrag
POSTGRES_PORT=5432

# 逾時與備援（共用層 §四）：失敗改走本地備援模型，本地都失敗就暫停服務
CONNECT_TIMEOUT_S=5
GENERATE_TIMEOUT_S=60
RETRIES=1

# 展示用：/admin 的「模擬斷線」按鈕（只停主推論伺服器）；正式公開前改 false
DEMO_CONTROLS=true
